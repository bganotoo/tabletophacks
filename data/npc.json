{
  "tavern-name": [
    "The {adjective.capitalize} {noun#concrete.capitalize}",
    "The {noun#animal.capitalize} & {noun#concrete.capitalize}"
  ],
  "npc-quirk": [
    "hums sea shanties constantly",
    "can't whistle but tries anyway",
    "whistles through their teeth when pronouncing an S sound",
    "collects teeth",
    "never says a person's name",
    "calls everyone 'sunny'",
    "always remembers the 'good old days'",
    "is obsessed with puns",
    "always mutters under their breath",
    "always confuses left and right",
    "is alergic to everything",
    "is a hoarder",
    "misplaces everything",
    "can never remember the names of things",
    "does everything with a flourish",
    "is extremely gullable when treasure is involved",
    "is afraid of {noun#animal.plural}",
    "talks with a lisp"
  ],
  "loot": [
    { "text": "{2-20} gold pieces", "tags": ["treasure"] },
    { "text": "{a} {metal} ring", "tags": ["treasure"] },
    { "text": "{a} {adjective} {noun#concrete}", "tags": ["treasure"] },
    { "text": "a map to {a} {noun#treasure}", "tags": ["treasure"] }
  ],
  "npc": {
    "name": "{adjective.capitalize} {noun#animal.capitalize}",
    "hp": "{3d6}",
    "inventory": { "$repeat": "1d4", "of": "{loot}", "unique": true },
    "quirk": { "$maybe": 0.3, "value": "{npc-quirk}" },
    "home": {
      "$or": [
        { "type": "tavern", "name": "{tavern-name}" },
        { "type": "hovel", "$weight": 3 }
      ]
    }
  }
}
